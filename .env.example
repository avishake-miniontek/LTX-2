# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/ltx_server.log

# Model Paths
MODEL_CHECKPOINT=models/ltx-2-19b-dev-fp8.safetensors
DISTILLED_LORA=models/ltx-2-19b-distilled-lora-384.safetensors
SPATIAL_UPSAMPLER=models/ltx-2-spatial-upscaler-x2-1.0.safetensors
GEMMA_ROOT=models/gemma-3-12b-it

# Generation Settings
OUTPUT_DIR=./output
DATABASE_URL=sqlite+aiosqlite:///./ltx_video.db

# Cleanup Settings
FILE_RETENTION_HOURS=4
CLEANUP_INTERVAL_MINUTES=30

# Request Timeout (in seconds)
REQUEST_TIMEOUT=3600

# Device
DEVICE=cuda